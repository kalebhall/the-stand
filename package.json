{
  "name": "the-stand",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint --no-config-lookup --ext .js,.mjs scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/vitest.mjs",
    "build": "node scripts/next-build.mjs",
    "test:e2e": "npm --workspace @the-stand/web run test:e2e",
    "docs:dependencies": "node scripts/dependency-graph.mjs",
    "docs:dependencies:check": "node scripts/dependency-graph.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
