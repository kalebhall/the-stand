{
  "name": "the-stand",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint --config eslint.config.mjs scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/vitest.mjs",
    "build": "node scripts/next-build.mjs",
    "test:e2e": "npm --workspace @the-stand/web run test:e2e",
    "docs:dependencies": "node scripts/dependency-graph.mjs",
    "docs:dependencies:check": "node scripts/dependency-graph.mjs --check",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.5.3"
  }
}
