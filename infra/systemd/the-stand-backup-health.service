[Unit]
Description=The Stand backup health check
After=local-fs.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/the-stand/backup-health.env
ExecStart=/usr/local/bin/the-stand-backup-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/the-stand/backups
