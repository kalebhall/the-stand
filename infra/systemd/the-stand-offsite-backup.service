[Unit]
Description=Replicate The Stand backups to encrypted Proxmox storage
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/the-stand/offsite-backup.env
ExecStart=/usr/local/bin/the-stand-offsite-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/root/.cache/restic
ReadOnlyPaths=/opt/the-stand/backups /etc/the-stand/offsite-restic-password /root/.ssh/the-stand-backup-replication /root/.ssh/config
