# .env.example — The Stand
APP_BASE_URL=https://stand.yourdomain.com
PORT=3000

DATABASE_URL=postgresql://stand_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/the_stand

# Bootstrap Support Admin (Option 1)
SUPPORT_ADMIN_EMAIL=you@example.com
# Required for first bootstrap. Store securely; never log this value.
SUPPORT_ADMIN_INITIAL_PASSWORD=replace_me_with_strong_one_time_password

# Auth/session
#
# SESSION_SECRET — used to sign and encrypt session cookies.
#   Generate with:  openssl rand -base64 48
#
# AUTH_SECRET — used internally by NextAuth to sign JWTs and CSRF tokens.
#   Generate with:  openssl rand -base64 48
#   (or run: npx auth secret)
#
# These two values MUST be different from each other.
SESSION_SECRET=replace_me_with_long_random_secret
AUTH_SECRET=replace_me_with_long_random_secret
AUTH_URL=https://stand.yourdomain.com
AUTH_GOOGLE_ID=replace_me_google_client_id
AUTH_GOOGLE_SECRET=replace_me_google_client_secret
PASSWORD_AUTH_ENABLED=true

# Encryption key for secrets-at-rest (oauth_config)
# Must be exactly 32 bytes (64 hex characters).
# Used by AES-256 to encrypt sensitive data stored in the database.
#   Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=replace_me

# HMAC secret for matching imported members without storing birthdays.
# Generate with: openssl rand -base64 48
MEMBER_IDENTITY_SECRET=replace_me_with_long_random_secret

# Redis for background jobs (optional but recommended)
REDIS_URL=redis://127.0.0.1:6379

# Notifications
NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:5678/webhook/the-stand

# Email is disabled unless explicitly configured. SMTP works with most providers.
# Use: disabled | smtp | webhook
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL_FROM=notifications@yourdomain.com
# NOTIFICATION_EMAIL_REPLY_TO=admin@yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# Optional legacy/advanced adapter:
# NOTIFICATION_EMAIL_WEBHOOK_URL=https://example.com/email-webhook

# Application logging level: debug | info | warn | error
# Defaults to info when omitted or invalid.
LOG_LEVEL=info

# Sentry error monitoring (optional)
# Set SENTRY_ENABLED=true and provide DSNs to enable error/event reporting.
SENTRY_ENABLED=false
SENTRY_ORG=kalebhallcom
SENTRY_PROJECT=javascript-nextjs
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
