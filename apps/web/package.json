{
  "name": "@the-stand/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:components": "vitest run --environment jsdom components/*.vitest.tsx",
    "db:migrate": "node scripts/migrate.mjs",
    "purge:raw-imports": "node --experimental-strip-types src/imports/purge-runner.ts",
    "purge:retention": "node src/maintenance/retention-runner.mjs",
    "remind:interviews": "node --experimental-strip-types src/leadership/interview-reminder-runner.mjs",
    "remind:technology": "node --experimental-strip-types src/leadership/technology-reminder-runner.mjs",
    "worker": "node --experimental-strip-types src/notifications/worker-entry.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bullmq": "^5.76.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "jspdf": "^4.2.1",
    "next": "15.5.18",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.8",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "eslint": "^9.27.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.2.2"
  }
}
